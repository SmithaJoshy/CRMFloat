# Environment Variables for Design Pipeline CRM

# Server Configuration
NODE_ENV=development
PORT=5000

# Database Configuration (MongoDB Atlas - Free tier)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/design-pipeline-crm?retryWrites=true&w=majority

# JWT Secret (Change this to a secure random string)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Email Configuration (Gmail SMTP - Free)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Twilio Configuration (Free trial)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Cloudinary Configuration (Free tier)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Escalation Email
ESCALATION_EMAIL=founder@yourcompany.com

# Client Configuration
REACT_APP_API_URL=http://localhost:5000/api
