{
  "name": "crmfloat",
  "version": "1.0.0",
  "description": "CRMFloat - Where Customer Relationships Flow Seamlessly",
  "main": "server/server.js",
  "scripts": {
    "start": "NODE_ENV=production node server/server.js",
    "dev": "NODE_ENV=development node server/server.js",
    "dev:mock": "PORT=3002 NODE_ENV=development node server-mock-v2.js",
    "dev:build": "npm run build && npm run dev",
    "build": "cd client && npm install && CI=false npm run build",
    "build:client": "cd client && npm install && npm run build",
    "build:server": "cd server && npm install",
    "install-client": "cd client && npm install",
    "install-all": "npm install && cd client && npm install && cd server && npm install",
    "postinstall": "npm run build:server && npm run build:client",
    "seed": "cd server && npm run seed",
    "test": "cd server && npm test && cd ../client && npm test",
    "test:server": "cd server && npm test",
    "test:client": "cd client && npm test",
    "docker:build": "docker build -f deployment/docker/Dockerfile -t design-pipeline-crm .",
    "docker:run": "cd deployment/docker && docker-compose up -d",
    "docker:stop": "cd deployment/docker && docker-compose down",
    "k8s:deploy": "kubectl apply -f deployment/kubernetes/",
    "k8s:delete": "kubectl delete -f deployment/kubernetes/",
    "deploy": "./deploy.sh",
    "deploy:local": "./deploy-local.sh",
    "deploy:production": "./deploy-production.sh",
    "local": "PORT=3002 NODE_ENV=development node server/server.js",
    "production": "NODE_ENV=production PORT=8081 node server/server.js"
  },
  "keywords": [
    "crm",
    "crmfloat",
    "customer-relationship-management",
    "project-management",
    "kanban",
    "pipeline",
    "business-management",
    "sales-crm",
    "client-management"
  ],
  "author": "CRMFloat Team",
  "license": "Commercial",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}
