  "dashboard": {
    "title": "GHS Design Studio Dashboard",
    "subtitle": "Manage your design projects and client relationships",
    "widgets": [
      {
        "type": "pipeline-overview",
        "title": "Design Pipeline Overview",
        "size": "large"
      },
      {
        "type": "active-projects",
        "title": "Active Projects",
        "size": "medium"
      },
      {
        "type": "designer-performance",
        "title": "Designer Performance",
        "size": "medium"
      },
      {
        "type": "warranty-tracking",
        "title": "Warranty Tracking",
        "size": "small"
      },
      {
        "type": "site-visits",
        "title": "Upcoming Site Visits",
        "size": "small"
      }
    ]
  },
  "workflow": {
    "stages": [
      {
        "id": "lead-generation",
        "name": "Lead Generation",
        "description": "Initial lead capture and qualification",
        "color": "#2196F3",
        "icon": "person_add"
      },
      {
        "id": "initial-engagement",
        "name": "Initial Engagement",
        "description": "First contact with potential client",
        "color": "#00BCD4",
        "icon": "handshake"
      },
      {
        "id": "scheduling-visit",
        "name": "Scheduling Visit",
        "description": "Site visit appointment scheduled",
        "color": "#4CAF50",
        "icon": "schedule"
      },
      {
        "id": "consultation",
        "name": "Consultation & Data Capture",
        "description": "Site visit completed, requirements gathered",
        "color": "#8BC34A",
        "icon": "room_preferences"
      },
      {
        "id": "design-brief",
        "name": "Design Brief & Proposal",
        "description": "Design proposal and quotation prepared",
        "color": "#CDDC39",
        "icon": "description"
      },
      {
        "id": "design-development",
        "name": "Design Development",
        "description": "Design concepts and mood boards",
        "color": "#FFC107",
        "icon": "palette"
      },
      {
        "id": "detailed-drawings",
        "name": "Detailed Drawings & Vendor Coordination",
        "description": "Technical drawings and vendor selection",
        "color": "#FF9800",
        "icon": "architecture"
      },
      {
        "id": "project-execution",
        "name": "Project Execution",
        "description": "Active construction/implementation",
        "color": "#FF5722",
        "icon": "construction"
      },
      {
        "id": "handover",
        "name": "Handover",
        "description": "Project completion and client handover",
        "color": "#9C27B0",
        "icon": "home"
      },
      {
        "id": "project-closure",
        "name": "Project Closure",
        "description": "Final sign-off and documentation",
        "color": "#4CAF50",
        "icon": "check_circle"
      },
      {
        "id": "warranty-period",
        "name": "Warranty Period",
        "description": "Post-completion warranty support",
        "color": "#2196F3",
        "icon": "verified_user"
      }
    ]
  },
  "forms": {
    "client": {
      "title": "Add New Client",
      "fields": [
        "name",
        "email",
        "phone",
        "propertyType",
        "propertySize",
        "designStyle",
        "budgetRange"
      ]
    },
    "project": {
      "title": "Add New Project",
      "fields": [
        "projectName",
        "clientId",
        "propertyType",
        "dealType",
        "projectSize",
        "designStyle",
        "roomsIncluded",
        "siteAddress",
        "expectedStartDate",
        "estimatedDuration",
        "designerAssigned"
      ]
    },
    "designer": {
      "title": "Add New Designer",
      "fields": [
        "name",
        "email",
        "phone",
        "designSpecialty",
        "experienceYears",
        "certifications",
        "portfolioLink"
      ]
    }
  },
  "notifications": {
    "siteVisitReminder": {
      "enabled": true,
      "message": "Site visit scheduled for {projectName} at {siteAddress} on {date}"
    },
    "warrantyExpiry": {
      "enabled": true,
      "message": "Warranty for {projectName} expires in {days} days"
    },
    "designApproval": {
      "enabled": true,
      "message": "Design approval required for {projectName}"
    }
  }
}
